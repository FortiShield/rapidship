RAPIDSIP_TRACE=true
RAPIDSIP_GIT_TRACE=true
RAPIDSIP_PRINCIPAL_ADMIN_EMAIL=admin@rapidship.io
RAPIDSIP_PRINCIPAL_ADMIN_PASSWORD=changeit
RAPIDSIP_WEBHOOK_ALLOW_LOOPBACK=true
RAPIDSIP_METRIC_ENABLED=false
RAPIDSIP_HTTP_HOST=localhost
RAPIDSIP_GITSPACE_ENABLE=true
RAPIDSIP_DEBUG=true
RAPIDSIP_DOCKER_API_VERSION=1.45
RAPIDSIP_SSH_ENABLE=true
RAPIDSIP_SSH_HOST=localhost
RAPIDSIP_SSH_PORT=2222

RAPIDSIP_REGISTRY_STORAGE_TYPE=filesystem
RAPIDSIP_REGISTRY_FILESYSTEM_ROOT_DIRECTORY=/tmp